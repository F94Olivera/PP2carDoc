{
  "name": "@cardoc/back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/edge.mjs serve",
    "build": "tsc -p tsconfig.json --noEmit && node scripts/edge.mjs build",
    "start": "node scripts/edge.mjs serve",
    "seed:superheroes": "tsx --env-file=../../.env ../../scripts/seed-superheroes.ts",
    "lint": "eslint \"**/*.{js,mjs,jsx,ts,tsx}\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:auth": "node --env-file=../../.env scripts/smoke-auth.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "esbuild": "0.25.12",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  }
}
