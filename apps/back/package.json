{
  "name": "@cardoc/back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node --env-file=../../.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "seed:users": "NODE_ENV=development tsx --env-file=../../.env src/scripts/seed-users.ts",
    "seed:superheroes": "tsx --env-file=../../.env ../../scripts/seed-superheroes.ts",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --no-error-on-unmatched-pattern",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@cardoc/types": "workspace:*",
    "arktype": "^2.2.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "swagger-ui-express": "^5.0.1"
  }
}
