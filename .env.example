# Backend
PORT_BACK=3001
LOG_LEVEL=info

# Supabase local Postgres (valores de desarrollo, no credenciales de producción)
# Para Supabase remoto, usar la conexión del proyecto y DATABASE_SSL=true.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false

# Supabase Auth: URL y clave publicable del mismo proyecto.
# Local: obtener la clave con pnpm supabase status.
# Remoto: copiar la URL y la publishable key desde el dashboard del proyecto.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key

# No se necesitan JWT_SECRET ni SUPABASE_SERVICE_ROLE_KEY para este login.

# Frontend: mismo proyecto Supabase que el backend.
PORT_FRONT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
