# Backend Edge: puerto interno 8000; URL pública local en 54321/functions/v1/api.
LOG_LEVEL=info

# Supabase local Postgres (valores de desarrollo, no credenciales de producción)
# Para Supabase remoto, usar la conexión del proyecto y DATABASE_SSL=true.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false

# Frontend y herramientas locales: URL y clave publicable del mismo proyecto.
# La función Edge usa SUPABASE_URL y SUPABASE_PUBLISHABLE_KEYS/SUPABASE_ANON_KEY
# inyectados por el runtime; no sobrescribirlos con secretos de producción.
# Local: obtener la clave con pnpm supabase status.
# Remoto: copiar la URL y la publishable key desde el dashboard del proyecto.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key

# No se necesitan JWT_SECRET ni SUPABASE_SERVICE_ROLE_KEY para este login.

# Frontend: mismo proyecto Supabase que el backend.
PORT_FRONT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:54321/functions/v1/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key

# Opcional: pooler remoto para repositorios Drizzle en Edge (secreto del backend).
# EDGE_DATABASE_URL=postgresql://...

# Pruebas de autenticación: usuario existente del proyecto que se esté probando.
# Nunca subir credenciales reales a este archivo.
# TEST_LOGIN_EMAIL=your-test-user@example.test
# TEST_LOGIN_PASSWORD=replace-with-test-password
# TEST_API_URL=http://127.0.0.1:54321/functions/v1/api
